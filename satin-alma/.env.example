# Satın Alma – ortam değişkenleri
# Bu dosyayı .env.local olarak kopyalayın. Gizli değerleri ASLA koda, sohbete veya e-postaya yazmayın.
# Hiçbir değişken NEXT_PUBLIC_ ile başlamaz: tarayıcıya hiçbir anahtar gönderilmez.

# --- Veritabanı (Supabase Postgres) -------------------------------------------
# Supabase → Database → Connection string → "Transaction pooler" (6543) adresi; kullanıcı: satinalma_app (db/setup/app-role.sql).
# Boş bırakılırsa (yalnızca geliştirmede) .data/pglite içindeki yerel deneme veritabanı kullanılır.
DATABASE_URL=
# İsteğe bağlı: Supabase SSL kök sertifikası (PEM, satır sonları \n). Verilirse sunucu sertifikası doğrulanır.
DATABASE_SSL_CA=
# YALNIZCA yerelde süper kullanıcıyla bağlanılan Postgres için: 1 ise işlemler kısıtlı role geçer (RLS uygulanır).
DB_USE_TENANT_ROLE=

# --- Giriş (Supabase Auth) ------------------------------------------------------
# supabase = e-posta + parola (üretim). dev = parolasız deneme girişi (YALNIZCA yerel geliştirme).
AUTH_MODE=supabase
SUPABASE_URL=
# "anon"/"publishable" anahtarı: yalnızca sunucuda kullanılır.
SUPABASE_ANON_KEY=
# "service_role"/"secret" anahtarı: uygulamadan kullanıcı açmak, parola vermek ve Supabase Storage için. GİZLİ, yalnızca sunucuda.
SUPABASE_SERVICE_ROLE_KEY=
# İlk kurulum: bu e-postayla (Supabase panelinde açılan) ilk giriş yapan kişi "satın alma + finans/klinik yöneticisi" olur.
BOOTSTRAP_ADMIN_EMAIL=

# --- Dosyalar --------------------------------------------------------------------
# db (varsayılan): fotoğraf/fatura dosyaları veritabanında (yedekle birlikte alınır).
# supabase: Supabase Storage'daki ÖZEL kovada (SUPABASE_SERVICE_ROLE_KEY gerekir). Büyük arşivler için önerilir.
FILE_STORAGE=db
SUPABASE_STORAGE_BUCKET=satin-alma

# --- Ortam etiketi (isteğe bağlı) ----------------------------------------------
# Test/önizleme ortamında ekranın üstünde kırmızı şerit gösterir. Üretimde BOŞ bırakın.
APP_ENV_LABEL=
