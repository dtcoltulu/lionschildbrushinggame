# DENTINEL – ortam değişkenleri
# Bu dosyayı .env.local olarak kopyalayın. Gizli değerleri ASLA koda, sohbete veya e-postaya yazmayın.
# Hiçbir değişken NEXT_PUBLIC_ ile başlamaz: tarayıcıya hiçbir anahtar gönderilmez.

# --- Veritabanı (Supabase Postgres) -------------------------------------------
# Supabase → Project Settings → Database → Connection string → "Transaction pooler" (6543) adresi.
# Boş bırakılırsa (yalnızca geliştirmede) .data/pglite içindeki yerel deneme veritabanı kullanılır.
DATABASE_URL=
# İsteğe bağlı: Supabase SSL kök sertifikası (PEM, satır sonları \n). Verilirse sunucu sertifikası doğrulanır.
DATABASE_SSL_CA=
# YALNIZCA yerelde süper kullanıcıyla bağlanılan Postgres için: 1 ise klinik işlemleri kısıtlı role geçer (RLS uygulanır).
# Üretimde boş: uygulama zaten NOBYPASSRLS bir rolle (cihaz_app) bağlanır.
DB_USE_TENANT_ROLE=

# --- Giriş (Supabase Auth) ------------------------------------------------------
# supabase = e-posta + parola (üretim). dev = parolasız deneme girişi (YALNIZCA yerel geliştirme).
AUTH_MODE=supabase
SUPABASE_URL=
# "anon"/"publishable" anahtarı: yalnızca sunucuda kullanılır.
SUPABASE_ANON_KEY=
# "service_role"/"secret" anahtarı: klinik şifrelerini belirlemek ve kişisel hesap açmak için. GİZLİ, yalnızca sunucuda.
SUPABASE_SERVICE_ROLE_KEY=
# İsteğe bağlı: kliniklerin ortak giriş hesaplarının alan adı (varsayılan klinik.dentinel.invalid; bu adrese e-posta gitmez).
CLINIC_LOGIN_EMAIL_DOMAIN=
# İlk kurulum: bu e-postayla (Supabase panelinde açılan) ilk giriş yapan kişi genel yönetici olur. Sonra boşaltılabilir.
BOOTSTRAP_ADMIN_EMAIL=

# --- Ortam etiketi (isteğe bağlı) ----------------------------------------------
# Test/önizleme ortamında ekranın üstünde kırmızı şerit gösterir. Üretimde BOŞ bırakın.
APP_ENV_LABEL=
